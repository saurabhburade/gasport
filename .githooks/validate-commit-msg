#!/bin/sh

set -eu

if [ "$#" -ne 1 ]; then
  echo "commit-msg: expected the path to Git's commit message file" >&2
  exit 2
fi

message_file=$1

if [ ! -f "$message_file" ]; then
  echo "commit-msg: commit message file not found: $message_file" >&2
  exit 2
fi

# Git-generated messages are intentionally allowed. They are not authored as
# Conventional Commits, but rejecting them would break merge/revert workflows.
first_line=$(awk '
  /^[[:space:]]*#/ { next }
  /^[[:space:]]*$/ { next }
  { sub(/\r$/, ""); print; exit }
' "$message_file")

if [ -z "$first_line" ]; then
  echo "commit-msg: commit message must contain a non-empty subject" >&2
  exit 1
fi

case "$first_line" in
  Merge\ *|Revert\ \"*\")
    exit 0
    ;;
  fixup\!\ *|squash\!\ *)
    # autosquash messages point at an existing commit subject and are created
    # by Git tooling rather than by the authoring convention.
    exit 0
    ;;
esac

# Conventional Commit header:
#   type[(scope)][!]: description
# The scope is deliberately permissive (excluding whitespace and delimiters)
# so project-specific scopes such as "ui/button" remain valid.
if printf '%s\n' "$first_line" | awk '
  match($0, /^[a-z]+(\([^()[:space:]]+\))?(!)?:[[:space:]]*[^[:space:]].*$/) { ok = 1 }
  END { exit(ok ? 0 : 1) }
'; then
  exit 0
fi

cat >&2 <<'EOF'
commit-msg: invalid commit message.
Use Conventional Commits, for example:
  feat: add wallet connection
  fix(api)!: reject an expired quote
Common types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert.
Merge, Revert, fixup!, and squash! messages generated by Git are accepted.
EOF
exit 1
