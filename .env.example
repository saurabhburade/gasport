# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reown / AppKit (Coinbase Wallet is exposed through AppKit; no Coinbase API key)
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Stable server-side key for signed SIWX nonce/session cookies. Required in production.
# Generate a random value and keep it private; NEXTAUTH_SECRET can be used instead.
SIWX_SESSION_SECRET=

# NEAR Intents 1Click (server-only)
NEAR_INTENTS_API_URL=https://1click.chaindefuser.com
NEAR_INTENTS_EXPLORER_API_URL=https://explorer.near-intents.org/api
# Optional JWT for authenticated 1Click limits and deposit submission.
# Never rename this with a NEXT_PUBLIC_ prefix or expose it to the browser.
NEAR_INTENTS_API_KEY=
# Override only if NEAR publishes a rotated quote-signing key.
NEAR_INTENTS_MANAGER_PUBLIC_KEY=
NEAR_INTENTS_REFERRER_ID=
# Application fee in basis points. Leave at 0 to disable fees.
NEAR_INTENTS_FEE_BPS=0
NEAR_INTENTS_FEE_RECIPIENT=

# LI.FI (server-only, optional)
LIFI_API_KEY=

# Platform fee recipient for direct LI.FI batches. The adapter charges 1% of
# the post-sponsorship route amount. When omitted, it falls back to the source
# gas recipient below, then to NEAR_INTENTS_FEE_RECIPIENT.
PLATFORM_FEE_RECIPIENT=

# Sponsored source-gas recovery (server-only EVM address). When omitted, the
# app falls back to NEAR_INTENTS_FEE_RECIPIENT if that value is an EVM address.
SPONSORED_GAS_FEE_RECIPIENT=

# Alchemy Gas Manager (server-only). A chain-specific policy overrides the
# shared fallback for that chain.
ALCHEMY_API_KEY=
ALCHEMY_POLICY_ID=
ALCHEMY_POLICY_ID_ETHEREUM=
ALCHEMY_POLICY_ID_BASE=
ALCHEMY_POLICY_ID_ARBITRUM=
ALCHEMY_POLICY_ID_OPTIMISM=
ALCHEMY_POLICY_ID_MONAD=

# Local HTTP development needs a temporary HTTPS proxy. Hosted HTTPS builds
# automatically use their own /api/gas/sponsored route.
NEXT_PUBLIC_PAYMASTER_PROXY_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
